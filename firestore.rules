rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'kumarrachith0@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public catalog reads
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Temporarily allow for seeding
    }
    match /brands/{brandId} { allow read: if true; allow write: if false; }
    match /categories/{categoryId} { allow read: if true; allow write: if false; }
    match /productFamilies/{familyId} { allow read: if true; allow write: if false; }
    match /productModels/{modelId} { allow read: if true; allow write: if false; }
    match /productVariants/{variantId} { allow read: if true; allow write: if false; }
    match /skus/{skuId} { allow read: if true; allow write: if false; }
    match /productImages/{imageId} { allow read: if true; allow write: if false; }
    match /inventory/{inventoryId} { allow read: if true; allow write: if false; }
    match /prices/{priceId} { allow read: if true; allow write: if false; }
    match /sellers/{sellerId} { allow read: if true; allow write: if false; }

    // User private data
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /data/{document=**} { allow read, write: if isOwner(userId); }
      match /cart/{document=**} { allow read, write: if isOwner(userId); }
      match /wishlist/{document=**} { allow read, write: if isOwner(userId); }
      match /orders/{document=**} { allow read: if isOwner(userId); allow create: if isOwner(userId); allow update, delete: if false; } // Can't update order status from client
      match /returns/{document=**} { allow read: if isOwner(userId); allow create: if isOwner(userId); allow update, delete: if false; } // Can't approve returns from client
      match /owned-products/{document=**} { allow read, write: if isOwner(userId); } // Changed from ownedProducts to owned-products
      match /serviceRecords/{document=**} { allow read: if isOwner(userId); allow write: if false; } 
    }
    
    
    
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      // Client can create but cannot set verifiedPurchase or trustScore
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && (!request.resource.data.keys().hasAny(['verifiedPurchase', 'trustScore']) 
                        || request.resource.data.verifiedPurchase == false);
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedPurchase', 'trustScore', 'userId']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
