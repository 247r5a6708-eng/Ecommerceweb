rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
        
    function isAdmin() {
      // Dynamic RBAC check. We still allow the original hardcoded email as a fallback Super Admin to prevent lockout
      return isAuthenticated() && (
        request.auth.token.email == 'kumarrachith0@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'support']
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public catalog reads
    match /products/{productId} { allow read: if true; allow write: if true; }
    match /brands/{brandId} { allow read: if true; allow write: if true; }
    match /categories/{categoryId} { allow read: if true; allow write: if true; }
    match /productFamilies/{familyId} { allow read: if true; allow write: if true; }
    match /productModels/{modelId} { allow read: if true; allow write: if true; }
    match /productVariants/{variantId} { allow read: if true; allow write: if true; }
    match /skus/{skuId} { allow read: if true; allow write: if true; }
    match /productImages/{imageId} { allow read: if true; allow write: if true; }
    match /inventory/{inventoryId} { allow read: if true; allow write: if true; }
    match /prices/{priceId} { allow read: if true; allow write: if true; }
    match /sellers/{sellerId} { allow read: if true; allow write: if true; }

    // User private data
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      // Specifically protect the role field from being modified by the owner themselves
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])) || isAdmin();
      
      match /data/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /cart/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /wishlist/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /orders/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /returns/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /owned-products/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /serviceRecords/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
    }
            
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && (!request.resource.data.keys().hasAny(['verifiedPurchase', 'trustScore']) 
                        || request.resource.data.verifiedPurchase == false);
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedPurchase', 'trustScore', 'userId']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
